---
import YouTubeVideo from "./YouTubeVideo.astro";
import charlasData from "../data/charlas2024.json";

interface Talk {
  id: number;
  title: string;
  videoId: string;
  thumbnail: string;
}

const talks: Talk[] = charlasData;
---

<section id="charlas2024" class="py-16 px-4">
  <div class="max-w-7xl mx-auto">
    <h2
      class="text-center text-5xl font-bold mb-16 bg-gradient-to-r from-white to-[#A412BA] bg-clip-text text-transparent leading-tight"
    >
      Recap 2024
    </h2>

  </div>

  <!-- Blindma1den Hack & Code 2025 Section -->
  <div class="max-w-7xl mx-auto mt-16 px-4 relative z-10">
    <div
      class="bg-gray-800/40 backdrop-blur-sm rounded-2xl p-8 border border-cyan-400/50 hover:border-cyan-400/70 transition-all duration-300"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <!-- Carousel -->
        <div class="space-y-4 order-1 lg:order-1">
          <div class="relative overflow-hidden w-full">
            <div
              id="carousel-section"
              class="flex pb-4 transition-transform duration-500 ease-in-out"
            >
              <!-- Duplicate videos for infinite scroll -->
              {
                talks.map((talk, index) => (
                  <div class="flex-none w-full">
                    <YouTubeVideo
                      videoId={talk.videoId}
                      title={talk.title}
                      thumbnail={talk.thumbnail}
                    />
                  </div>
                ))
              }
              {
                talks.map((talk, index) => (
                  <div class="flex-none w-full">
                    <YouTubeVideo
                      videoId={talk.videoId}
                      title={talk.title}
                      thumbnail={talk.thumbnail}
                    />
                  </div>
                ))
              }
            </div>

            <!-- Navigation arrows -->
            <button
              id="prevBtn-section"
              class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full p-2 transition-all duration-300 backdrop-blur-sm"
              aria-label="Previous videos"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>

            <button
              id="nextBtn-section"
              class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white rounded-full p-2 transition-all duration-300 backdrop-blur-sm"
              aria-label="Next videos"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>

          <!-- Dots indicator -->
          <div class="flex justify-center gap-2">
            {
              talks.map((_, index) => (
                <button
                  class="dot-section w-3 h-3 rounded-full bg-gray-600 hover:bg-[#A412BA] transition-all duration-300"
                  data-slide={index}
                  aria-label={`Go to slide ${index + 1}`}
                />
              ))
            }
          </div>
        </div>

        <!-- Content -->
        <div class="space-y-6 order-2 lg:order-2">
          <h3 class="text-3xl font-bold text-white">
            💡 Así vivimos Blindma1den Hack&Code&nbsp;2024
          </h3>

          <div class="space-y-4 text-gray-300">
            <p class="leading-relaxed">
              El año pasado, más de <strong>420&nbsp;personas de toda&nbsp;Latinoamérica</strong> se conectaron para vivir 5&nbsp;días de charlas, workshops y un CTF&nbsp;virtual&nbsp;inolvidable. 🌎✨
            </p>
            
            <p class="leading-relaxed">
              Este 2025 lo transformamos:
            </p>
            <p class="leading-relaxed">
              👉 Podrás inscribirte para vivir la&nbsp;experiencia <strong>online</strong> desde cualquier lugar del&nbsp;mundo.
            </p>
            <p class="leading-relaxed">
              👉 O unirte de forma <strong>presencial en&nbsp;Madrid</strong>, en La&nbsp;Nave, donde la comunidad cobrará&nbsp;vida.
            </p>

            <p class="leading-relaxed">
              🎤 Las conferencias seguirán siendo <strong>gratuitas</strong> para todos.
            </p>
            <p class="leading-relaxed">
              🔥 Pero si quieres vivir la verdadera adrenalina, el <strong>CTF&nbsp;+&nbsp;Hackathon</strong> es tu boleto de&nbsp;entrada al&nbsp;reto.
            </p>
          </div>

          <!-- <div class="flex justify-center">
            <a
              href="/registro"
              class="inline-block bg-[#753BE8] hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 shadow-lg shadow-[#753BE8]/40 hover:shadow-xl hover:shadow-[#753BE8]/60 hover:-translate-y-1 active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-[#753BE8]/30 uppercase tracking-wide text-lg min-w-[120px] text-center"
            >
              🚀 Sí, quiero ser parte este 2025
            </a>
          </div> -->
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const carousel = document.getElementById("carousel-section");
    const prevBtn = document.getElementById("prevBtn-section");
    const nextBtn = document.getElementById("nextBtn-section");
    const dots = document.querySelectorAll(".dot-section");

    if (!carousel || !prevBtn || !nextBtn) return;

    const slideWidth = carousel.offsetWidth; // Width of the carousel container
    const totalSlides = dots.length;
    let currentSlide = 0;
    let isTransitioning = false;

    // Set initial position (start from first duplicate set)
    carousel.style.transform = `translateX(0px)`;

    function updateDots() {
      dots.forEach((dot, index) => {
        const actualIndex = currentSlide % totalSlides;
        if (index === actualIndex) {
          dot.classList.remove("bg-gray-600");
          dot.classList.add("bg-[#A412BA]");
        } else {
          dot.classList.remove("bg-[#A412BA]");
          dot.classList.add("bg-gray-600");
        }
      });
    }

    function goToSlide(slideIndex: number) {
      if (isTransitioning) return;

      isTransitioning = true;
      currentSlide = slideIndex;

      const translateX = -currentSlide * slideWidth;
      carousel.style.transform = `translateX(${translateX}px)`;

      updateDots();

      // Handle infinite loop
      setTimeout(() => {
        if (currentSlide >= totalSlides) {
          // Reset to beginning without transition
          carousel.style.transition = "none";
          currentSlide = 0;
          carousel.style.transform = `translateX(0px)`;

          // Re-enable transition
          setTimeout(() => {
            carousel.style.transition = "transform 0.5s ease-in-out";
            isTransitioning = false;
          }, 50);
        } else if (currentSlide < 0) {
          // Reset to end without transition
          carousel.style.transition = "none";
          currentSlide = totalSlides - 1;
          carousel.style.transform = `translateX(${-currentSlide * slideWidth}px)`;

          // Re-enable transition
          setTimeout(() => {
            carousel.style.transition = "transform 0.5s ease-in-out";
            isTransitioning = false;
          }, 50);
        } else {
          isTransitioning = false;
        }
        updateDots();
      }, 500);
    }

    // Previous button
    prevBtn.addEventListener("click", () => {
      goToSlide(currentSlide - 1);
    });

    // Next button
    nextBtn.addEventListener("click", () => {
      goToSlide(currentSlide + 1);
    });

    // Dot navigation
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        goToSlide(index);
      });
    });

    // Auto-scroll every 4 seconds
    setInterval(() => {
      goToSlide(currentSlide + 1);
    }, 4000);

    // Initialize
    updateDots();
  });
</script>

<style>
  /* Hide scrollbar for webkit browsers */
  #carousel-section::-webkit-scrollbar {
    display: none;
  }

  /* Smooth scrolling for better UX */
  #carousel-section {
    scroll-behavior: smooth;
  }
</style>
