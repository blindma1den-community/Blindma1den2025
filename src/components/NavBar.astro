---
export interface Props {
	activePage?: string;
}

const { activePage } = Astro.props;

const navItems = [
	{ name: "Inicio", href: "/" },
	{ name: "Speakers", href: "/#speakers" },
	{ name: "Charlas2024", href: "/#charlas2024" },
	{ name: "Evento", href: "/#event-description" },
	{ name: "Registro", href: "/registro" },
	// { name: "Actividades", href: "#actividades" },
	// { name: "Sponsors", href: "#sponsors" },
	{ name: "FAQ", href: "/#faq" },
	{ name: "Contacto", href: "/#contacto" },
];
---

<nav
	id="navbar"
	class="fixed top-0 left-0 w-full z-50
         bg-transparent text-white
         transition-all duration-300 ease-in-out"
>
	<div class="max-w-7xl mx-auto px-4">
		<div class="flex items-center justify-between min-h-[5rem] md:min-h-[8.5rem] py-2">
			<!-- Logo -->
			<a href="/" class="flex items-center">
				<img src="/logo.png" alt="Logo" class="h-16 md:h-32 w-auto" />
			</a>

			<!-- Desktop links -->
			<div class="hidden md:flex space-x-6 items-center">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class={`px-3 py-2 rounded-md text-sm font-medium
                    ${item.href === activePage ? "bg-white/20" : ""}
                    hover:bg-white/10 transition`}
						>
							{item.name}
						</a>
					))
				}
			</div>

			<!-- Mobile button (unchanged) -->
			<button id="mobile-menu-toggle" class="md:hidden p-2">
				<svg
					class="h-6 w-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile Menu -->
	<div id="mobile-menu" class="md:hidden hidden bg-[#2E0967]/95 backdrop-blur-md border-t border-white/10">
		<div class="px-4 pt-2 pb-3 space-y-1">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class={`block px-3 py-2 rounded-md text-sm font-medium text-white
                ${(item.href === activePage || (item.href === "/" && activePage === "/")) ? "bg-white/20" : ""}
                hover:bg-white/10 transition`}
					>
						{item.name}
					</a>
				))
			}
		</div>
	</div>
</nav>

<!-- Mobile Menu Toggle Script -->
<script>
	const button = document.getElementById(
		"mobile-menu-toggle",
	) as HTMLButtonElement;
	const menu = document.getElementById("mobile-menu");

	if (button && menu) {
		button.addEventListener("click", () => {
			const expanded = button.getAttribute("aria-expanded") === "true";
			button.setAttribute("aria-expanded", String(!expanded));
			menu.classList.toggle("hidden");
		});

		// Cierra el menú si se hace clic fuera
		document.addEventListener("click", (e) => {
			const target = e.target as HTMLElement;
			if (!button.contains(target) && !menu.contains(target)) {
				menu.classList.add("hidden");
				button.setAttribute("aria-expanded", "false");
			}
		});
	}

	const nav = document.getElementById("navbar") as HTMLElement;

	const updateNavbar = () => {
		if (window.scrollY > 40) {
			nav.classList.remove("bg-transparent");
			nav.classList.add("bg-[#2E0967]/60", "backdrop-blur-[41.67px]");
		} else {
			nav.classList.add("bg-transparent");
			nav.classList.remove("bg-[#2E0967]/60", "backdrop-blur-[41.67px]");
		}
	};

	// Aplicar el estado inicial basado en la posición actual del scroll
	updateNavbar();

	// Escuchar eventos de scroll
	window.addEventListener("scroll", updateNavbar, { passive: true });
</script>
