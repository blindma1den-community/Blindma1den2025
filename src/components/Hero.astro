<!-- Hero Section -->
<section
	class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-900 via-purple-900 to-purple-700"
	id="hero"
>
	<!-- Video de fondo optimizado -->
	<video
		id="hero-video"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		class="absolute inset-0 w-full h-full object-cover z-10"
		style="pointer-events: none;"
	>
		<!-- WebM para escritorio (2.1MB - mejor calidad) -->
		<source
			src="/ondas-fondo.webm"
			type="video/webm"
		/>
		<!-- MP4 fallback (872KB - compatible) -->
		<source src="/ondas-fondo.mp4" type="video/mp4" />
		<!-- Fallback para navegadores que bloquean video -->
		Tu navegador no soporta videos. El contenido sigue funcionando normalmente.
	</video>
	
	<!-- Imagen de respaldo si el video falla -->
	<div id="video-fallback" class="absolute inset-0 w-full h-full object-cover z-10 bg-gradient-to-br from-[#242467] via-[#2E0967] to-[#1B0123] opacity-0 transition-opacity duration-1000"></div>
	
	<!-- Mensaje discreto para usuarios de Brave -->
	<div id="brave-notice" class="fixed bottom-4 right-4 z-[9999] bg-gradient-to-r from-purple-900 to-blue-900 backdrop-blur text-white text-sm px-4 py-3 rounded-xl opacity-0 transition-all duration-500 max-w-sm border-2 border-purple-400 shadow-2xl transform translate-y-2">
		<div class="flex items-start gap-2">
			<span class="text-lg">🛡️</span>
			<div>
				<div class="font-bold text-purple-100">Brave Browser Detected</div>
				<div class="text-xs text-purple-200 mt-1">
					For animated background, disable "Block fingerprinting" in Brave's shield settings
				</div>
			</div>
		</div>
	</div>

	<!-- Overlay sutil para mejorar contraste del texto -->
	<div class="absolute inset-0 bg-black/25 backdrop-blur-[0.5px] z-20"></div>

	<!-- Contenido principal -->
	<div class="relative z-30 text-center px-4 py-20 max-w-6xl mx-auto">
		<!-- Nivel 1: Información más importante - Call to action principal -->
		<h1
			class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white mb-6 leading-tight"
		>
			<span class="drop-shadow-2xl bg-gradient-to-r from-white via-purple-100 to-white bg-clip-text text-transparent">
				<span class="text-yellow-400">⚡</span> ¿Listo para hackear, aprender y&nbsp;ganar?
			</span>
		</h1>

		<!-- Nivel 2: Información secundaria - Descripción del evento -->
		<h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-purple-100 mb-8 leading-relaxed opacity-90">
			<span class="drop-shadow-lg">
				Blindma1den Hack&Code
			</span>
		</h2>

		<!-- Nivel 3: Información de apoyo - Detalles específicos -->
		<h3 class="text-lg sm:text-xl md:text-2xl font-medium text-purple-200 mb-6 leading-relaxed opacity-80">
			<span>3&nbsp;días de retos, comunidad y&nbsp;adrenalina</span>
		</h3>

		<p
			class="text-base sm:text-lg md:text-xl text-purple-300 mb-12 opacity-75 drop-shadow-lg font-light"
		>
			📍 Hacker House, Madrid&nbsp;| Octubre&nbsp;3–5&nbsp;
		</p>

		<a
			href="/registro"
			class="inline-block bg-[#753BE8] hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 shadow-lg shadow-[#753BE8]/40 hover:shadow-xl hover:shadow-[#753BE8]/60 hover:-translate-y-1 active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-[#753BE8]/30 uppercase tracking-wide text-lg min-w-[120px] text-center"
		>
			👉 Quiero unirme al reto
		</a>
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const video = document.getElementById('hero-video') as HTMLVideoElement;
		const fallback = document.getElementById('video-fallback') as HTMLElement;
		let videoCheckInterval: ReturnType<typeof setInterval>;
		let hasVideoPlayed = false;

		if (!video || !fallback) return;

		// Verificar que los elementos existen
		const braveNotice = document.getElementById('brave-notice');

		// Detectar Brave y su configuración de fingerprinting
		const isBrave = !!(navigator as any).brave || navigator.userAgent.includes('Brave');
		const hasBraveShields = !!(navigator as any).brave;
		
		// Configuración adicional para mejorar compatibilidad con Brave
		video.defaultMuted = true;
		video.muted = true;
		video.volume = 0;
		
		// Función para detectar si el video está siendo bloqueado por Brave
		function detectBraveVideoBlock() {
			// Verificar si el video tiene dimensiones válidas
			const hasValidDimensions = video.videoWidth > 0 && video.videoHeight > 0;
			// Verificar si el video está realmente cargado
			const isLoaded = video.readyState >= 2;
			// Verificar si no está pausado por políticas del navegador
			const isNotBlocked = !video.paused || hasVideoPlayed;
			
			return !(hasValidDimensions && isLoaded && isNotBlocked);
		}

		// Función para mostrar mensaje de Brave
		function showBraveMessage() {
			const braveNotice = document.getElementById('brave-notice');
			if (braveNotice) {
				braveNotice.style.opacity = '1';
				// Ocultar el mensaje después de 10 segundos
				setTimeout(() => {
					braveNotice.style.opacity = '0';
				}, 10000);
			}
		}

		// Si detectamos Brave, usar estrategia más conservadora
		if (isBrave || hasBraveShields) {
			
			// Mostrar mensaje después de un breve delay para testing
			setTimeout(() => {
				showBraveMessage();
			}, 2000);
			
			// Verificar después de un momento si el video se está bloqueando
			setTimeout(() => {
				const isBlocked = detectBraveVideoBlock();
				
				if (isBlocked || !hasVideoPlayed) {
					showFallback();
					showBraveMessage();
				}
			}, 4000);
		}

		// Función para mostrar fallback
		function showFallback() {
			if (fallback) {
				fallback.style.opacity = '1';
			}
		}

		// Función para ocultar fallback
		function hideFallback() {
			if (fallback) {
				fallback.style.opacity = '0';
			}
		}

		// Detectar si el video se reproduce correctamente
		function checkVideoPlayback() {
			if (video && (video.paused || video.ended || video.readyState < 2)) {
				if (hasVideoPlayed) {
					showFallback();
				}
			} else {
				hasVideoPlayed = true;
				hideFallback();
			}
		}

		// Múltiples intentos de reproducción para evitar bloqueos
		function attemptVideoPlay(attempts = 3) {
			const playPromise = video.play();
			
			if (playPromise !== undefined) {
				playPromise
					.then(() => {
						hasVideoPlayed = true;
						hideFallback();
					})
					.catch((error: unknown) => {
						if (attempts > 1) {
							// Reintentar después de un breve delay
							setTimeout(() => attemptVideoPlay(attempts - 1), 500);
						} else {
							// Último intento: forzar reproducción sin audio
							video.muted = true;
							video.volume = 0;
							const finalAttempt = video.play();
							
							if (finalAttempt !== undefined) {
								finalAttempt
									.then(() => {
										hasVideoPlayed = true;
										hideFallback();
									})
									.catch(() => {
										showFallback();
									});
							} else {
								showFallback();
							}
						}
					});
			}
		}

		// Comenzar intentos de reproducción
		attemptVideoPlay();

		// Verificar periodicamente el estado del video
		videoCheckInterval = setInterval(checkVideoPlayback, 1000);

		// Cleanup interval cuando se cambia de página
		window.addEventListener('beforeunload', () => {
			if (videoCheckInterval) {
				clearInterval(videoCheckInterval);
			}
		});

		// Detectar cambios de visibilidad de la página (para Brave)
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) {
				// Página oculta
				if (video && !video.paused) {
					video.pause();
				}
			} else {
				// Página visible
				if (video && video.paused) {
					attemptVideoPlay();
				}
			}
		});

		// Activar video con cualquier interacción del usuario
		function enableVideoOnInteraction() {
			if (!hasVideoPlayed && video.paused) {
				attemptVideoPlay();
			}
		}

		// Timeout de seguridad - ajustado para Brave
		const timeoutDuration = (isBrave || hasBraveShields) ? 1500 : 3000;
		setTimeout(() => {
			if (!hasVideoPlayed || (video && video.paused)) {
				showFallback();
				
				// Si es Brave y el video falló, mostrar mensaje
				if (isBrave || hasBraveShields) {
					showBraveMessage();
				}
			}
		}, timeoutDuration);
		
		// Test final - mostrar mensaje después de 5 segundos si es Brave
		if (isBrave) {
			setTimeout(() => {
				const braveElement = document.getElementById('brave-notice');
				if (braveElement) {
					braveElement.style.opacity = '1';
					braveElement.style.transform = 'translateY(0)';
				} else {
				}
			}, 5000);
		}
		
	});
</script>
