---
---

<section id="contacto" class="py-16 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="bg-gray-800/40 backdrop-blur-sm rounded-2xl p-8 border-2 border-cyan-400/70">
      <!-- Title -->
      <h2 class="text-center text-5xl font-bold mb-12 bg-gradient-to-r from-white to-[#A412BA] bg-clip-text text-transparent leading-tight">
        Contáctanos
      </h2>
      
      <!-- Contact Form -->
      <div class="max-w-2xl mx-auto">
        <form id="contactForm" class="space-y-6">
        <!-- CSRF Protection -->
        <input type="hidden" id="csrf_token" name="csrf_token" value="" />
        <input type="hidden" id="session_id" name="session_id" value="" />
        
        <!-- Email Field -->
        <div class="form-group">
          <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
            Email
          </label>
          <input 
            type="email" 
            id="email" 
            name="email"
            required
            maxlength="254"
            class="w-full px-4 py-3 bg-transparent border-b-2 border-gray-600 text-white placeholder-gray-400 focus:border-cyan-400 focus:outline-none transition-colors duration-300"
            placeholder="tu@email.com"
          />
        </div>
        
        <!-- Name Field -->
        <div class="form-group">
          <label for="nombre" class="block text-sm font-medium text-gray-300 mb-2">
            Nombre y Apellido
          </label>
          <input 
            type="text" 
            id="nombre" 
            name="nombre"
            required
            maxlength="100"
            class="w-full px-4 py-3 bg-transparent border-b-2 border-gray-600 text-white placeholder-gray-400 focus:border-cyan-400 focus:outline-none transition-colors duration-300"
            placeholder="Tu nombre completo"
          />
        </div>
        
        <!-- Message Field -->
        <div class="form-group">
          <label for="mensaje" class="block text-sm font-medium text-gray-300 mb-2">
            Mensaje
          </label>
          <textarea 
            id="mensaje" 
            name="mensaje"
            rows="6"
            required
            maxlength="1000"
            class="w-full px-4 py-3 bg-transparent border-2 border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-cyan-400 focus:outline-none transition-colors duration-300 resize-none"
            placeholder="Escribe tu mensaje aquí..."
          ></textarea>
        </div>
        
        <!-- Submit Button -->
        <div class="flex justify-center">
          <button 
            type="submit"
            class="bg-[#753BE8] hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 shadow-lg shadow-[#753BE8]/40 hover:shadow-xl hover:shadow-[#753BE8]/60 hover:-translate-y-1 active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-[#753BE8]/30 uppercase tracking-wide text-lg min-w-[120px]"
          >
            Enviar mensaje
          </button>
        </div>
        </form>
        
        <!-- Success/Error Messages -->
        <div id="form-message" class="mt-6 p-4 rounded-lg hidden">
          <p id="message-text"></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', async function() {
    const form = document.getElementById('contactForm');
    const messageDiv = document.getElementById('form-message');
    const messageText = document.getElementById('message-text');
    const submitButton = form?.querySelector('button[type="submit"]');
    
    // Initialize CSRF protection
    await initializeCSRF();
    
    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Disable submit button to prevent double submission
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Enviando...';
        }
        
        try {
          // Get form data
          const formData = new FormData(form);
          
          // Basic client-side validation
          const email = formData.get('email');
          const nombre = formData.get('nombre');
          const mensaje = formData.get('mensaje');
          
          if (!email || !nombre || !mensaje) {
            showMessage('Por favor, completa todos los campos.', 'error');
            return;
          }
          
          // Email validation
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            showMessage('Por favor, ingresa un email válido.', 'error');
            return;
          }
          
          // Length validation
          if (nombre.length < 2 || nombre.length > 100) {
            showMessage('El nombre debe tener entre 2 y 100 caracteres.', 'error');
            return;
          }
          
          if (mensaje.length < 10 || mensaje.length > 1000) {
            showMessage('El mensaje debe tener entre 10 y 1000 caracteres.', 'error');
            return;
          }
          
          // Submit to secure API endpoint
          const response = await fetch('/api/contact', {
            method: 'POST',
            body: formData
          });
          
          const result = await response.json();
          
          if (result.success) {
            showMessage(result.message, 'success');
            form.reset();
            // Regenerate CSRF token for next submission
            await initializeCSRF();
          } else {
            showMessage(result.error || 'Error al enviar el mensaje.', 'error');
          }
          
        } catch (error) {
          console.error('Contact form error:', error);
          showMessage('Error de conexión. Intenta de nuevo más tarde.', 'error');
        } finally {
          // Re-enable submit button
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = 'Enviar mensaje';
          }
        }
      });
    }
    
    async function initializeCSRF() {
      try {
        const response = await fetch('/api/csrf-token');
        const data = await response.json();
        
        if (data.success) {
          document.getElementById('csrf_token').value = data.data.csrf_token;
          document.getElementById('session_id').value = data.data.session_id;
        }
      } catch (error) {
        console.error('CSRF token initialization error:', error);
      }
    }
    
    function showMessage(message, type) {
      if (messageText && messageDiv) {
        messageText.textContent = message;
        messageDiv.className = `mt-6 p-4 rounded-lg ${
          type === 'success' 
            ? 'bg-green-500/20 border border-green-500/50 text-green-300' 
            : 'bg-red-500/20 border border-red-500/50 text-red-300'
        }`;
        messageDiv.classList.remove('hidden');
        
        // Hide message after 5 seconds
        setTimeout(() => {
          messageDiv.classList.add('hidden');
        }, 5000);
      }
    }
  });
</script>

<style>
  /* Custom focus styles for better accessibility */
  .form-group input:focus,
  .form-group textarea:focus {
    box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.2);
  }
  
  /* Smooth transitions for form elements */
  .form-group input,
  .form-group textarea {
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  
  /* Placeholder styling */
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    transition: opacity 0.3s ease;
  }
  
  .form-group input:focus::placeholder,
  .form-group textarea:focus::placeholder {
    opacity: 0.7;
  }
</style>