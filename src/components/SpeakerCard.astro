---
interface Speaker {
  id: number;
  name: string;
  title: string;
  image: string;
  bio: string;
  country: string;
  twitter: string;
}

interface Props {
  speaker: Speaker;
}

const { speaker } = Astro.props;
---

<div 
  id={`speaker-card-${speaker.id}`} 
  class="speaker-popup fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 md:p-8 opacity-0 invisible transition-all duration-300"
  style="height: 100vh; height: 100dvh;"
>
  <div class="speaker-card bg-gradient-to-br from-[#2E0967] via-[#3C1E5E] to-[#1B0123] rounded-3xl shadow-2xl max-w-md w-full mx-auto transform scale-95 transition-all duration-300 border border-[#A412BA]/30 max-h-[85vh] max-h-[85dvh] overflow-y-auto">
    <div class="relative overflow-hidden rounded-t-3xl">
      <div class="absolute top-3 right-3 z-20">
        <button class="close-popup w-10 h-10 bg-red-500/80 backdrop-blur-sm rounded-full flex items-center justify-center text-white hover:bg-red-600 transition-all duration-200 shadow-lg border-2 border-white/20">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="aspect-[4/3] md:aspect-[3/2] lg:aspect-square relative">
        <img 
          src={speaker.image} 
          alt={speaker.name}
          class="w-full h-full object-cover object-top"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#2E0967]/60 to-transparent"></div>
      </div>
    </div>

    <div class="p-4 lg:p-6 space-y-3 lg:space-y-4">
      <div class="text-center border-b border-[#A412BA]/30 pb-3 lg:pb-4">
        <h3 class="text-xl lg:text-2xl font-bold text-white mb-1 lg:mb-2">
          {speaker.name}
        </h3>
        <p class="text-[#A412BA] font-medium text-base lg:text-lg" set:html={speaker.title}>
        </p>
        <p class="text-gray-300 text-xs lg:text-sm mt-1 flex items-center justify-center gap-1">
          <span class="text-sm lg:text-lg">🌍</span>
          {speaker.country}
        </p>
      </div>

      <div class="space-y-2 lg:space-y-3">
        <div>
          <h4 class="text-white font-semibold mb-1 lg:mb-2 text-xs lg:text-sm uppercase tracking-wide">Biografía</h4>
          <p class="text-gray-300 text-xs lg:text-sm leading-relaxed" set:html={speaker.bio}>
          </p>
        </div>

        {speaker.twitter && (
          <div class="pt-2 lg:pt-3 border-t border-[#A412BA]/20">
            <div class="flex items-center justify-center">
              <a 
                href={`https://x.com/${speaker.twitter}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 lg:px-4 py-1.5 lg:py-2 bg-gradient-to-r from-[#A412BA] to-[#753BE8] text-white font-medium text-sm lg:text-base rounded-full hover:from-[#753BE8] hover:to-[#A412BA] transition-all duration-300 transform hover:scale-105"
              >
                <svg class="w-4 h-4 lg:w-5 lg:h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                @{speaker.twitter}
              </a>
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</div>

<script define:vars={{ speakerId: speaker.id }}>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.querySelector(`#speaker-card-${speakerId}`);
    if (!popup) return;

    const closeBtn = popup.querySelector('.close-popup');
    
    const closePopup = () => {
      popup.classList.add('opacity-0', 'invisible');
      popup.querySelector('.speaker-card')?.classList.add('scale-95');
      document.body.classList.remove('overflow-hidden');
      
      // Remove viewport meta changes for mobile
      const viewport = document.querySelector('meta[name=viewport]');
      if (viewport) {
        viewport.setAttribute('content', 'width=device-width, initial-scale=1.0');
      }
    };
    
    const openPopup = () => {
      // Prevent background scrolling
      document.body.classList.add('overflow-hidden');
      
      // Adjust viewport for mobile browsers with dynamic bars
      const viewport = document.querySelector('meta[name=viewport]');
      if (viewport) {
        viewport.setAttribute('content', 'width=device-width, initial-scale=1.0, viewport-fit=cover');
      }
    };
    
    // Listen for popup opening (when classes are removed)
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          const classList = popup.classList;
          if (!classList.contains('opacity-0') && !classList.contains('invisible')) {
            openPopup();
          }
        }
      });
    });
    
    observer.observe(popup, { attributes: true });
    
    closeBtn?.addEventListener('click', closePopup);
    
    // Close on backdrop click
    popup.addEventListener('click', (e) => {
      if (e.target === popup) {
        closePopup();
      }
    });
    
    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !popup.classList.contains('invisible')) {
        closePopup();
      }
    });
    
    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      observer.disconnect();
    });
  });
</script>