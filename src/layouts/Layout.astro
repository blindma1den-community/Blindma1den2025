---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

export interface Props {
	title: string;
	description?: string;
	activePage?: string;
}

const { title, description = "Somos una comunidad de&nbsp;desarrolladores y&nbsp;profesionales de&nbsp;ciberseguridad, que buscan compartir información y&nbsp;ayudar a&nbsp;los&nbsp;juniors a&nbsp;entrar en&nbsp;la&nbsp;carrera", activePage } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Preload recursos críticos -->
		<link rel="preload" href="/logo.png" as="image" />
		<link rel="preload" href="/ondas-fondo.webm" as="video" type="video/webm" />
		
		<!-- Fallback fonts para Brave -->
		<style>
			* {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
			}
		</style>
		
		<title>{title}</title>
	</head>

	<!-- 🔧 Body en columna y altura mínima 100vh -->
	<body
		class="flex flex-col min-h-screen
             bg-[linear-gradient(180deg,#242467_0%,#2E0967_30%,#3C1E5E_70%,#1B0123_100%)]
             text-gray-100"
	>
		<!-- Header fijo -->
		<NavBar activePage={activePage} />

		<!-- Contenido que empuja el footer hasta abajo -->
		<main class="flex-1">
			<slot />
		</main>

		<!-- Footer fijo abajo -->
		<Footer />
	</body>
</html>
