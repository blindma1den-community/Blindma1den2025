---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Registro - Blindma1den Hack&Code 2025"
  description="Regístrate para participar en Blindma1den Hack&Code 2025. Comunidad de desarrolladores y profesionales de ciberseguridad que ayudan a juniors a entrar en la carrera."
  activePage="/registro"
>
  <section class="pt-32 pb-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left side - Form -->
        <div
          class="bg-gray-800/40 backdrop-blur-sm rounded-2xl p-8 border border-cyan-400/50 hover:border-cyan-400/70 transition-all duration-300"
        >
          <h1 class="text-4xl font-bold text-white mb-2">
            Tu aventura comienza&nbsp;aquí
          </h1>

          <p class="text-gray-300 mb-8 leading-relaxed">
            Rellena este formulario para participar en hackathon o CTF y nos
            pondremos en&nbsp;contacto contigo. La participación tiene un costo
            de <strong class="text-white">25&nbsp;USD</strong> por persona y contarás
            con una sesión de&nbsp;mentoría ¿Estás listo? ¡Vamos!
          </p>

          <form id="registration-form" class="space-y-4">
            <!-- Row 1: Nombre y Apellido -->
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-white font-medium mb-2"
                  >Nombre</label
                >
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="Tu nombre"
                />
              </div>

              <div>
                <label for="apellido" class="block text-white font-medium mb-2"
                  >Apellido</label
                >
                <input
                  type="text"
                  id="apellido"
                  name="apellido"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="Tu apellido"
                />
              </div>
            </div>

            <!-- Row 2: Username de X y Email -->
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label
                  for="username_x"
                  class="block text-white font-medium mb-2">Username de X</label
                >
                <div class="relative">
                  <span
                    class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"
                    >@</span
                  >
                  <input
                    type="text"
                    id="username_x"
                    name="username_x"
                    required
                    class="w-full pl-8 pr-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                    placeholder="tu_usuario"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-white font-medium mb-2"
                  >Email</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="tu@email.com"
                />
              </div>
            </div>

            <!-- Row 3: Modalidad y País -->
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label for="modalidad" class="block text-white font-medium mb-2"
                  >¿Hackathon o CTF?</label
                >
                <select
                  id="modalidad"
                  name="modalidad"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                >
                  <option value="" class="bg-gray-800 text-white"
                    >Selecciona una opción</option
                  >
                  <option value="CTF" class="bg-gray-800 text-white">CTF</option
                  >
                  <option value="Hackathon" class="bg-gray-800 text-white"
                    >Hackathon</option
                  >
                </select>
              </div>

              <div>
                <label for="pais" class="block text-white font-medium mb-2"
                  >País de residencia</label
                >
                <input
                  type="text"
                  id="pais"
                  name="pais"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="Tu país"
                />
              </div>
            </div>

            <!-- Row 4: Nombre de equipo y Número de integrantes -->
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label
                  for="nombre_equipo"
                  class="block text-white font-medium mb-2"
                  >Nombre de tu equipo</label
                >
                <input
                  type="text"
                  id="nombre_equipo"
                  name="nombre_equipo"
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="Nombre de tu equipo (opcional)"
                />
              </div>

              <div>
                <label
                  for="num_integrantes"
                  class="block text-white font-medium mb-2"
                  >Número de integrantes (Max 3)</label
                >
                <input
                  type="number"
                  id="num_integrantes"
                  name="num_integrantes"
                  min="1"
                  max="3"
                  required
                  class="w-full px-4 py-2.5 rounded-lg bg-white/10 backdrop-blur-sm border border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#753BE8] focus:border-transparent transition-all duration-300"
                  placeholder="1"
                />
              </div>
            </div>

            <!-- Privacy Policy Checkbox -->
            <div class="flex items-start space-x-3 pt-4">
              <input
                type="checkbox"
                id="privacy_policy"
                name="privacy_policy"
                required
                class="mt-1 h-4 w-4 rounded border border-gray-600 bg-white/10 backdrop-blur-sm text-[#753BE8] focus:ring-2 focus:ring-[#753BE8] focus:ring-offset-0"
              />
              <label for="privacy_policy" class="text-sm text-gray-300 leading-relaxed">
                He leído y acepto la
                <a
                  href="/privacidad"
                  target="_blank"
                  class="text-[#753BE8] hover:text-purple-400 underline transition-colors"
                >
                  Política de Privacidad y Tratamiento de Datos Personales
                </a>
                de BLINDMA1DEN
              </label>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-center pt-6">
              <button
                type="submit"
                id="submit-button"
                class="bg-[#753BE8] hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 shadow-lg shadow-[#753BE8]/40 hover:shadow-xl hover:shadow-[#753BE8]/60 hover:-translate-y-1 active:translate-y-0 focus:outline-none focus:ring-4 focus:ring-[#753BE8]/30 uppercase tracking-wide text-lg min-w-[200px] disabled:opacity-50 disabled:cursor-not-allowed"
              >
                🚀 Proceder al Pago ($25)
              </button>
            </div>
          </form>

          <!-- Success/Error Messages -->
          <div id="form-message" class="mt-6 p-4 rounded-lg hidden">
            <p id="message-text" class="text-center font-medium"></p>
          </div>
        </div>

        <!-- Right side - Illustration -->
        <div class="hidden lg:flex items-center justify-center">
          <div class="relative">
            <!-- Illustration placeholder - you can replace this with the actual SVG -->
            <div
              class="w-96 h-96 bg-gradient-to-br from-purple-500/20 to-cyan-400/20 rounded-full flex items-center justify-center backdrop-blur-sm border border-white/10"
            >
              <div class="text-center space-y-4">
                <div class="text-8xl">💻</div>
                <h3 class="text-2xl font-bold text-white">
                  ¡Únete al&nbsp;desafío!
                </h3>
                <p class="text-gray-300">
                  Tu aventura en ciberseguridad comienza&nbsp;aquí
                </p>
              </div>
            </div>

            <!-- Floating elements -->
            <div
              class="absolute -top-4 -right-4 w-20 h-20 bg-cyan-400/20 rounded-lg rotate-12 backdrop-blur-sm"
            >
            </div>
            <div
              class="absolute -bottom-4 -left-4 w-16 h-16 bg-purple-500/20 rounded-full backdrop-blur-sm"
            >
            </div>
            <div
              class="absolute top-1/2 -left-8 w-12 h-12 bg-pink-500/20 rounded-lg rotate-45 backdrop-blur-sm"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("registration-form") as HTMLFormElement;
    const messageDiv = document.getElementById("form-message");
    const messageText = document.getElementById("message-text");
    const submitButton = document.getElementById("submit-button") as HTMLButtonElement;

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Disable button and show loading
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.innerHTML = '⏳ Procesando...';
        }

        try {
          // Get form data
          const formData = new FormData(form);
          const data = {
            nombre: formData.get("nombre") as string,
            apellido: formData.get("apellido") as string,
            email: formData.get("email") as string,
            telefono: formData.get("username_x") as string, // Usar username_x como telefono/contacto
            pais: formData.get("pais") as string,
            modalidad: formData.get("modalidad") as string,
            experiencia: '', // Campo opcional por ahora
            team_name: formData.get("nombre_equipo") as string,
            team_members: parseInt(formData.get("num_integrantes") as string) || 1,
          };

          // Validate required fields
          const requiredFields = ['nombre', 'apellido', 'email', 'telefono', 'pais', 'modalidad'];
          const errors = [];

          for (const field of requiredFields) {
            if (!data[field] || data[field].trim() === '') {
              errors.push(`El campo ${field} es obligatorio`);
            }
          }

          // Validate privacy policy checkbox
          const privacyCheckbox = document.getElementById('privacy_policy') as HTMLInputElement;
          if (!privacyCheckbox || !privacyCheckbox.checked) {
            errors.push('Debes aceptar la Política de Privacidad para continuar');
          }

          if (errors.length > 0) {
            showMessage(errors.join(', '), 'error');
            return;
          }

          // Send to PHP backend to create payment session
          const isDevelopment = window.location.hostname === 'localhost';
          const apiUrl = isDevelopment
            ? 'http://localhost:8080/create_payment.php'
            : '/create_payment.php';

          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || 'Error al procesar la solicitud');
          }

          if (result.success && result.checkout_url) {
            // Store temp_id in localStorage for later use
            localStorage.setItem('blindma1den_temp_id', result.temp_id);
            localStorage.setItem('blindma1den_session_id', result.session_id);

            // Redirect to Stripe Checkout
            window.location.href = result.checkout_url;
          } else {
            throw new Error('Error al crear la sesión de pago');
          }

        } catch (error) {
          console.error('Payment error:', error);
          showMessage(error.message || 'Error al procesar el pago', 'error');
        } finally {
          // Re-enable button
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.innerHTML = '🚀 Proceder al Pago ($25)';
          }
        }
      });
    }

    function showMessage(message: string, type: string) {
      if (messageDiv && messageText) {
        messageText.textContent = message;
        messageDiv.classList.remove(
          "hidden",
          "bg-green-500/20",
          "bg-red-500/20",
          "border-green-400",
          "border-red-400",
        );

        if (type === "success") {
          messageDiv.classList.add(
            "bg-green-500/20",
            "border",
            "border-green-400",
          );
          messageText.classList.remove("text-red-400");
          messageText.classList.add("text-green-400");
        } else {
          messageDiv.classList.add("bg-red-500/20", "border", "border-red-400");
          messageText.classList.remove("text-green-400");
          messageText.classList.add("text-red-400");
        }

        setTimeout(() => {
          messageDiv?.classList.add("hidden");
        }, 5000);
      }
    }
  });
</script>

<style>
  /* Custom styles for form elements */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input[type="number"] {
    -moz-appearance: textfield;
  }

  select option {
    background-color: #1f2937;
    color: white;
  }

  /* Animation for floating elements */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(12deg);
    }
    50% {
      transform: translateY(-10px) rotate(12deg);
    }
  }

  .absolute:nth-child(2) {
    animation: float 3s ease-in-out infinite;
  }

  .absolute:nth-child(3) {
    animation: float 4s ease-in-out infinite 0.5s;
  }

  .absolute:nth-child(4) {
    animation: float 5s ease-in-out infinite 1s;
  }

  @media (prefers-reduced-motion: reduce) {
    .absolute:nth-child(2),
    .absolute:nth-child(3),
    .absolute:nth-child(4) {
      animation: none;
    }
  }
</style>