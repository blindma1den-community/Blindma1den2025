---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Registro Temporalmente Deshabilitado - Blindma1den Hack&Code 2025"
  description="El registro está temporalmente deshabilitado mientras preparamos mejoras."
  activePage="/registro"
>
  <section class="pt-32 pb-16 px-4 min-h-screen flex items-center justify-center">
    <div class="max-w-2xl mx-auto text-center">
      <div class="bg-gray-800/40 backdrop-blur-sm rounded-2xl p-12 border border-cyan-400/50">
        
        <div class="text-6xl mb-8">🚧</div>
        
        <h1 class="text-4xl font-bold text-white mb-6">
          Registro Temporalmente Deshabilitado
        </h1>
        
        <p class="text-xl text-gray-300 mb-6 leading-relaxed">
          El sistema de registro está temporalmente fuera de servicio mientras preparamos mejoras para ofrecerte la mejor experiencia.
        </p>
        
        <p class="text-lg text-gray-300 mb-8">
          <strong class="text-white">¡Vuelve pronto!</strong> Estaremos listos muy pronto.
        </p>
        
        <div class="space-y-4">
          <a 
            href="/" 
            class="inline-block bg-[#753BE8] hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-all duration-300 shadow-lg shadow-[#753BE8]/40 hover:shadow-xl hover:shadow-[#753BE8]/60 hover:-translate-y-1"
          >
            ← Volver al Inicio
          </a>
          
          <div class="text-sm text-gray-400 mt-4">
            <p>Mientras tanto, puedes seguirnos en nuestras redes sociales para estar al día con las novedades.</p>
          </div>
        </div>
        
      </div>
    </div>
  </section>
</Layout>

<script>
  // Bloquear cualquier intento de acceso programático
  document.addEventListener('DOMContentLoaded', function() {
    // Bloquear formularios si existen
    const forms = document.querySelectorAll('form');
    forms.forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        alert('El registro está temporalmente deshabilitado.');
        return false;
      });
    });
    
    // Bloquear APIs de registro
    const originalFetch = window.fetch;
    window.fetch = function(...args) {
      const url = args[0];
      if (typeof url === 'string' && url.includes('/api/registro')) {
        return Promise.reject(new Error('Registro temporalmente deshabilitado'));
      }
      return originalFetch.apply(this, args);
    };
  });
</script>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .text-6xl {
    animation: float 3s ease-in-out infinite;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .text-6xl {
      animation: none;
    }
  }
</style>