---
import Layout from '../layouts/Layout.astro';

const posts = [
  { title: "Intro a Astro", date: "2024-01-15", excerpt: "Guía básica de Astro..." },
  { title: "Tailwind Tips", date: "2024-01-10", excerpt: "Mejores prácticas con Tailwind..." },
  { title: "Performance", date: "2024-01-05", excerpt: "Optimizando Astro para producción..." },
];
---

<Layout 
  title="Blog" 
  activePage="/blog"
>
  <section class="py-12">
    <h1 class="text-4xl font-bold text-center mb-12">Blog</h1>
    
    <div class="space-y-8 max-w-4xl mx-auto">
      {posts.map(post => (
        <article class="bg-white p-6 rounded-lg shadow hover:shadow-md transition">
          <h2 class="text-2xl font-bold mb-2">{post.title}</h2>
          <p class="text-gray-500 text-sm mb-3">{post.date}</p>
          <p class="text-gray-700">{post.excerpt}</p>
          <a href="#" class="text-blue-600 hover:underline mt-4 inline-block">
            Leer más →
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>